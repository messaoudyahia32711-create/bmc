# ==============================================================================
# BMC Tool - Environment Variables Template
# Copy this file to .env.local for local development
# And configure these in Vercel Project Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
# Connection pooling URL (Port 6543) - Used by Prisma Client in Serverless functions
DATABASE_URL="postgres://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct database connection URL (Port 5432) - Used for Prisma migrations
DIRECT_URL="postgres://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. Supabase API (Client & Auth)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 3. NextAuth Configuration (Optional if NextAuth is used)
# ------------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-generated-random-secret-key-32-chars-minimum"
